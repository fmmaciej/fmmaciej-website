{
    "commands": [
        {
            "cmd": "ls -1 ~/music",
            "type": "text",
            "output": [
                "bio/",
                "rider/",
                "photos/",
                "mixes/",
                "events/",
                "links/"
            ]
        },
        {
            "cmd": "find ~/music -maxdepth 2 -type f | sort | head",
            "type": "text",
            "output": [
                "/home/fm/music/bio/bio.md",
                "/home/fm/music/links/links.txt",
                "/home/fm/music/mixes/mwtg-498.url",
                "/home/fm/music/rider/rider.md"
            ]
        }
    ]
}
