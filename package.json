    "main": "index.js",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@playwright/test": "^1.62.1",
        "markdown-it-link-attributes": "^4.0.1"
    },
    "scripts": {
        "clean": "rm -fr www/",
        "dev": "eleventy --serve",

        "build:hash": "echo $(git rev-parse HEAD:src) > www/build.txt",
        "build:events": "tools/build_events.sh",
        "build:mixes": "tools/build_mixes.sh",
        "build:photos": "tools/build_photos.sh",
        "bundle:press-kit": "./tools/bundle_press_kit.sh",
        "build:content": "npm run build:events && npm run build:mixes && npm run build:photos && npm run bundle:press-kit",

        "build": "eleventy && npm run build:hash",
        "rebuild": "npm run clean && npm run build:content && npm run build",
        "generate:instagram-events": "node scripts/generate-instagram-events.js",
        "generate:instagram": "node scripts/generate-instagram.js",
        "test:data": "node --test tests/data-builders.test.js",
        "test:instagram": "node --test tests/instagram-events.test.js tests/instagram-story.test.js",
        "test:terminal": "node --test tests/terminal.test.js tests/terminal-idle.test.js tests/terminal-matrix.test.js",
        "test:runtime": "node --test tests/runtime-reliability.test.js",
        "test:owner-proof": "node --test tests/owner-proof.test.js",
        "test:llm-maintainer": "node --test tests/llm-maintainer.test.js",
        "test:smoke": "node --test tests/build-smoke.test.js",
        "test:e2e": "playwright test",
        "test:e2e:iphone": "playwright test --project=webkit-iphone",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test": "npm run test:data && npm run test:instagram && npm run test:terminal && npm run test:runtime && npm run test:owner-proof && npm run test:llm-maintainer",

        "check": "npm test && npm run build && npm run test:smoke && npm run test:e2e && git diff --check",

        "owner-proof": "node scripts/owner-proof.js set",
        "owner-proof:clear": "node scripts/owner-proof.js clear",
        "llm-maintainer:init": "node scripts/llm-maintainer.js init",
        "llm-maintainer:check": "node scripts/llm-maintainer.js check",
        "llm-maintainer:rotate": "node scripts/llm-maintainer.js rotate",
        "llm-maintainer:revoke": "node scripts/llm-maintainer.js revoke",

        "push": "git push",
        "deploy:check": "./tools/build_check.sh",
        "deploy:ovh": "./tools/deploy_ovh.sh",

        "deploy": "npm run deploy:check && npm run deploy:ovh"
    },
    "repository": {
        "type": "git",
        "url": "git@fmmaciej:fmmaciej/fmmaciej-website.git"
    },
