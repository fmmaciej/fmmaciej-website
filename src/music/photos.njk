---
title: FM — /music/photos
layout: layout.njk
terminalFile: /assets/terminal/music/photos.json
permalink: /music/photos/index.html
collectionPage:
  basePath: /music/photos/
  syncHash: true
  showTerminalCrumb: true
pageStyles:
  - /assets/css/components/music-collections.css
  - /assets/css/components/music-media-cards.css
  - /assets/css/sections/photos.css
pageScripts:
  - /assets/js/pages/page-boot.js
---

{% from "macros/music-collections.njk" import renderGroup %}

<div class="music-intro">
{% importMd "music/_content/intro/photos.md" %}
</div>

{% macro renderPhotoCard(photo) %}
<div class="music-photo-card">
    <a class="photo-preview" href="{{ photo.display1600 }}" target="_blank" rel="noopener" aria-label="{{ photo.alt }}">
        <img
            src="{{ photo.thumb480 }}"
            srcset="{{ photo.thumb480 }} 480w, {{ photo.thumb960 }} 960w, {{ photo.display1600 }} 1600w"
            sizes="(max-width: 600px) 100vw, (max-width: 1200px) 33vw, 25vw"
            alt="{{ photo.alt }}"
            width="{{ photo.thumb_w }}"
            height="{{ photo.thumb_h }}"
            loading="lazy" decoding="async">
    </a>
</div>
{% endmacro %}

{% macro renderPhotoSet(set) %}
<details class="photo-set" id="set-{{ set.id }}">
    <summary>
        <span class="photo-set-title">{{ set.date }} · {{ set.title }}</span>
        <span class="photo-set-details">
            {% if set.place %}{{ set.place }} · {% endif %}
            {% if set.authorInfo.name %}{{ set.authorInfo.name }} · {% endif %}
            {{ set.count }} photo{% if set.count != 1 %}s{% endif %}
        </span>
    </summary>
    {% if set.authorInfo.instagram or set.authorInfo.facebook or set.authorInfo.email %}
    <div class="photo-contact-list">
        {% if set.authorInfo.instagram %}<a href="{{ set.authorInfo.instagram.href }}" target="_blank" rel="noopener">{{ set.authorInfo.instagram.label }}</a>{% endif %}
        {% if set.authorInfo.facebook %}<a href="{{ set.authorInfo.facebook.href }}" target="_blank" rel="noopener">{{ set.authorInfo.facebook.label }}</a>{% endif %}
        {% if set.authorInfo.email %}<a href="{{ set.authorInfo.email.href }}">{{ set.authorInfo.email.label }}</a>{% endif %}
    </div>
    {% endif %}
    <div class="photo-set-gallery">
    {% for photo in set.photos %}
        {{ renderPhotoCard(photo) }}
    {% endfor %}
    </div>
</details>
{% endmacro %}

{% set groups = photoData.groups | default([]) %}
{% if groups | length %}
    {% for group in groups %}
    {% call renderGroup(group, group.photoCount, "list") %}
        {% for set in group.items %}{{ renderPhotoSet(set) }}{% endfor %}
    {% endcall %}
    {% endfor %}
{% else %}
<div class="group-empty">No photos added yet.</div>
{% endif %}

<br>
